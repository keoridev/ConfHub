{$SITE_ADDRESS} {
	encode zstd gzip
	@api path /api /api/*
	handle @api {
		reverse_proxy app:8080
	}
	handle {
		root * /srv
		# Matchers see the original path (/jury), not the rewritten /index.html,
		# so pages are matched as "everything outside /assets".
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
