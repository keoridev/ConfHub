# Generate the actual .env with: bash setup.sh --host YOUR_DOMAIN --configure-only
SITE_ADDRESS=example.com
PUBLIC_URL=https://example.com
POSTGRES_USER=confhub
POSTGRES_DB=confhub
# Use hexadecimal passwords to avoid URL/dotenv escaping problems.
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
JWT_SECRET=GENERATE_WITH_SETUP
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=GENERATE_WITH_SETUP
# Empty API key enables the existing demonstration AI response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TALKS_PER_STUDENT=10
AI_DAILY_LIMIT=20
